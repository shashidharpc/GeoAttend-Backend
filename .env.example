# ==============================================================================
# GeoAttend Backend Environment Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GITHUB.
# ==============================================================================

# ─── Flask Server & Cryptography ──────────────────────────────────────────────
# Generate a secure key in Python using: secrets.token_hex(32)
SECRET_KEY=your_generated_64_character_hex_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000

# ─── CORS Allowed Origins (Security Whitelist) ────────────────────────────────
# Comma-separated list of origins allowed to make API requests with credentials
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── MongoDB Database Configuration ───────────────────────────────────────────
MONGO_URI=mongodb+srv://shashidharpc_db_user:<db_password>@cluster0.lanadsm.mongodb.net/qr_attendance_db?retryWrites=true&w=majority
MONGO_DB_NAME=qr_attendance_db

# ─── Admin Master Credentials ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@edu.com
ADMIN_PASSWORD=admin1234

# ─── Geofencing & Security Validation Policy ──────────────────────────────────
# Geofence perimeter in meters around each classroom
ALLOWED_RADIUS_METERS=30
# QR Code auto-expiry duration in minutes
QR_EXPIRY_MINUTES=2

# ─── Session & Cookie Security Policies ───────────────────────────────────────
# Set to 'true' in HTTPS production environments
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_DAYS=7

# ─── Email & SMTP Notification Service (Flask-Mail) ───────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
MAIL_FROM=your_gmail_address@gmail.com
MAIL_SENDER_NAME=GeoAttend Attendance System

# ─── External Geolocation & Map APIs (Optional) ───────────────────────────────
GEOCODING_API_URL=https://nominatim.openstreetmap.org
MAPS_API_KEY=

